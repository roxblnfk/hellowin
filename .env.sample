# Environment (prod or local)
APP_ENV=local

# Debug mode set to TRUE disables view caching and enables higher verbosity
DEBUG=true

# Verbosity level
VERBOSITY_LEVEL=verbose # basic, verbose, debug

# Monolog: "roadrunner" sends logs to the RoadRunner log (stderr outside of RoadRunner)
MONOLOG_DEFAULT_CHANNEL=roadrunner
MONOLOG_DEFAULT_LEVEL=DEBUG # DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY

# Telemetry
TELEMETRY_DRIVER=null

# Tokenizer
TOKENIZER_CACHE_TARGETS=false
TOKENIZER_LOAD_CLASSES=true
TOKENIZER_LOAD_ENUMS=true
TOKENIZER_LOAD_INTERFACES=true

# View component options
VIEW_CACHE=false

# Broadcasting driver: centrifugo, log or null
BROADCAST_CONNECTION=centrifugo

# Centrifugo gRPC API address used by RoadRunner to publish into channels
CENTRIFUGO_GRPC_API=centrifugo:10000

# WebSocket endpoint for the browser and the Grafana dashboard link: ":<port>/path" takes the scheme and the host of the
# page, a full URL (wss://ws.example.com/connection/websocket) is used as is
CENTRIFUGO_WS_URL=:8000/connection/websocket
GRAFANA_URL=:3000/

# Clicks on a pumpkin that move it to its next stage
HELLOWIN_CLICKS_PER_STAGE=5

# Secret of the moderator console: open the page with ?moderator=<secret>; empty turns the console off
HELLOWIN_MODERATOR_SECRET=

# Last pumpkin stage of each scene, comma-separated and cumulative; the scene after the last one is the final scene.
# A leading 0 makes scene 0 the bar: no pumpkins there, always ready
HELLOWIN_SCENE_STAGE_MAX=0,4,8,11

# The bonfire in the middle: clicks per stage (the whole room clicks it) and its last stage by scene, cumulative;
# a scene whose value does not raise the bonfire is ready with the pumpkins alone
HELLOWIN_BONFIRE_CLICKS_PER_STAGE=20
HELLOWIN_BONFIRE_STAGE_MAX=0,0,4,7

# The magic circle on the ashes of the final scene: clicks that move it to its next stage and its last stage, where
# it is closed and the final scene is ready
HELLOWIN_CIRCLE_CLICKS_PER_STAGE=20
HELLOWIN_CIRCLE_STAGES=4

# Valkey: RoadRunner kv keeps the ritual there (host:port), the idempotency storage connects with predis (DSN)
VALKEY_ADDR=valkey:6379
VALKEY_DSN=tcp://valkey:6379

# Ticker (`hellowin:ticker`, a RoadRunner service): milliseconds between leaderboard builds and players in it
HELLOWIN_LEADERBOARD_INTERVAL=5000
HELLOWIN_LEADERBOARD_SIZE=10

# Flyers the ticker launches: milliseconds between launches (range or fixed), per-depth flight milliseconds and
# points from the farthest depth to the nearest, probabilities to take off from a bush and to fly in an arc
HELLOWIN_FLYER_INTERVAL=3000-8000
HELLOWIN_FLYER_DURATION=16000,6500,4000
HELLOWIN_FLYER_POINTS=3,2,1
HELLOWIN_FLYER_BUSH_CHANCE=0.4
HELLOWIN_FLYER_ARC_CHANCE=0.5
# Flyer kinds by scene from the bar on, sets separated by ";"; an empty set is a scene without flyers but its rare one
HELLOWIN_FLYER_KINDS=;duck,chicken;;bat;worm
# The cursed world's own set of kinds instead of its scene's, and points for a firefly at any depth
HELLOWIN_FLYER_KINDS_CURSED=worm,bat,firefly
HELLOWIN_FLYER_FIREFLY_POINTS=1
# The rare flyer of each scene (empty — none), how often a launch is it and its points
HELLOWIN_FLYER_RARE=;roadrunner;;;
HELLOWIN_FLYER_RARE_CHANCE=0.08
HELLOWIN_FLYER_RARE_POINTS=10

# Zombies of the cursed world: milliseconds between them (range or fixed), milliseconds from the patch to the edge
# of the lawn, points for one
HELLOWIN_ZOMBIE_INTERVAL=4000-9000
HELLOWIN_ZOMBIE_DURATION=14000
HELLOWIN_ZOMBIE_POINTS=2

# Characters on the lawn: percents of the screen per second along the path, and milliseconds without connections
# before a character leaves
HELLOWIN_WALK_SPEED=12
HELLOWIN_WALK_LEAVE_AFTER=5000

# RPC limits per player (per connection without one): "<per second>,<burst>" of a token bucket, 0 turns the limit
# off; click, shoot and move have their own buckets, every other method shares the last one
HELLOWIN_RPC_RATE_CLICK=20,40
HELLOWIN_RPC_RATE_SHOOT=20,40
HELLOWIN_RPC_RATE_MOVE=10,20
HELLOWIN_RPC_RATE_OTHER=10,30
