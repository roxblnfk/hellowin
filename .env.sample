# Environment (prod or local)
APP_ENV=local

# Debug mode set to TRUE disables view caching and enables higher verbosity
DEBUG=true

# Verbosity level
VERBOSITY_LEVEL=verbose # basic, verbose, debug

# Monolog: "roadrunner" sends logs to the RoadRunner log (stderr outside of RoadRunner)
MONOLOG_DEFAULT_CHANNEL=roadrunner
MONOLOG_DEFAULT_LEVEL=DEBUG # DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY

# Telemetry
TELEMETRY_DRIVER=null

# Tokenizer
TOKENIZER_CACHE_TARGETS=false
TOKENIZER_LOAD_CLASSES=true
TOKENIZER_LOAD_ENUMS=true
TOKENIZER_LOAD_INTERFACES=true

# View component options
VIEW_CACHE=false

# Broadcasting driver: centrifugo, log or null
BROADCAST_CONNECTION=centrifugo

# Centrifugo gRPC API address used by RoadRunner to publish into channels
CENTRIFUGO_GRPC_API=centrifugo:10000

# PHP workers answering Centrifugo (connect, subscribe, every RPC of the room): about two per core
RR_CENTRIFUGE_WORKERS=4

# WebSocket endpoint for the browser and the Grafana dashboard link: ":<port>/path" takes the scheme and the host of the
# page, a full URL (wss://ws.example.com/connection/websocket) is used as is
CENTRIFUGO_WS_URL=:8000/connection/websocket
GRAFANA_URL=:3000/

# Grafana is public and read-only: anonymous Viewer, no password login. To administer it, set
# GF_AUTH_DISABLE_LOGIN_FORM=false for a while with a strong GF_SECURITY_ADMIN_PASSWORD; the password only takes on the
# first start of the grafana-data volume, later: docker compose exec grafana grafana cli admin reset-admin-password <new>
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_SECURITY_ADMIN_PASSWORD=

# Every limit of the game is max(1, ceil(k × (BASE + PER_PLAYER × (n − 1)))) plus the moderator's bonus: n — figures on
# the floor (at least one), k — the moderator's multiplier; fractions are fine. Clicks per stage of a pumpkin, the
# bonfire and the magic circle; mugs the bar drinks before it may leave; mugs and slain zombies of the cursed world;
# FrankenPHP's health
HELLOWIN_PUMPKIN_BASE=2
HELLOWIN_PUMPKIN_PER_PLAYER=5
HELLOWIN_BONFIRE_BASE=8
HELLOWIN_BONFIRE_PER_PLAYER=20
HELLOWIN_CIRCLE_BASE=15
HELLOWIN_CIRCLE_PER_PLAYER=40
HELLOWIN_BAR_BASE=5
HELLOWIN_BAR_PER_PLAYER=1.5
HELLOWIN_CURSED_DRINKS_BASE=10
HELLOWIN_CURSED_DRINKS_PER_PLAYER=8
HELLOWIN_CURSED_ZOMBIES_BASE=15
HELLOWIN_CURSED_ZOMBIES_PER_PLAYER=12
HELLOWIN_BOSS_HP_BASE=45
HELLOWIN_BOSS_HP_PER_PLAYER=60

# Secret of the moderator console: open the page with ?moderator=<secret>; empty turns the console off
HELLOWIN_MODERATOR_SECRET=

# Last pumpkin stage of each scene, comma-separated and cumulative; the scene after the last one is the final scene.
# A leading 0 makes scene 0 the bar: no pumpkins there, ready once the room has drunk its goal
HELLOWIN_SCENE_STAGE_MAX=0,4,8,11

# The bonfire in the middle: its last stage by scene, cumulative; a scene whose value does not raise the bonfire is
# ready with the pumpkins alone
HELLOWIN_BONFIRE_STAGE_MAX=0,0,4,7

# The magic circle on the ashes of the final scene: its last stage, where it is closed and the final scene is ready
HELLOWIN_CIRCLE_STAGES=4

# The bar of scene 0: full mugs the counter has room for (the owl pours one per player on the floor, up to it),
# milliseconds the owl pours a batch, free places per mug of a batch (up to that many free places — one mug at once,
# up to twice as many — two) and the chance the owl mutters a rumour over a pour
HELLOWIN_BAR_MUGS=60
HELLOWIN_BAR_POUR_MS=2500
HELLOWIN_BAR_POUR_PER=10
HELLOWIN_BAR_RUMOR_CHANCE=0.33
# Milliseconds a sip plays (in the bar and in the cursed world) and a pumpkin hands its beer over: the server takes
# and drinks no mug meanwhile, so a click never skips the animation
HELLOWIN_DRINK_MS=1200
HELLOWIN_BEER_HANDOVER_MS=900
# Litres in one mug, for the beer drunk in the statistics
HELLOWIN_MUG_LITRES=0.5

# Valkey: RoadRunner kv keeps the ritual there (host:port), the idempotency storage connects with predis (DSN)
VALKEY_ADDR=valkey:6379
VALKEY_DSN=tcp://valkey:6379

# Flyers the ticker launches: milliseconds between launches (range or fixed), per-depth flight milliseconds and
# points from the farthest depth to the nearest, probabilities to take off from a bush and to fly in an arc
HELLOWIN_FLYER_INTERVAL=3000-8000
HELLOWIN_FLYER_DURATION=16000,6500,4000
HELLOWIN_FLYER_POINTS=3,2,1
HELLOWIN_FLYER_BUSH_CHANCE=0.4
HELLOWIN_FLYER_ARC_CHANCE=0.5
# Flyer kinds by scene from the bar on, sets separated by ";"; an empty set is a scene without flyers but its rare one
HELLOWIN_FLYER_KINDS=fly;duck,chicken;;bat;worm
# The cursed world's own set of kinds instead of its scene's, and points for a firefly at any depth
HELLOWIN_FLYER_KINDS_CURSED=worm,bat,firefly
HELLOWIN_FLYER_FIREFLY_POINTS=1
# The dawn's own set of kinds and its pace: many birds, often
HELLOWIN_FLYER_KINDS_DAWN=duck,chicken
HELLOWIN_FLYER_INTERVAL_DAWN=1000-2500
# Flies of the bar: landings, milliseconds on each, milliseconds between points, points for one
HELLOWIN_FLYER_FLY_STOPS=2-3
HELLOWIN_FLYER_FLY_SIT=900-1600
HELLOWIN_FLYER_FLY_LEG=900
HELLOWIN_FLYER_FLY_POINTS=1
# The rare flyer of each scene (empty — none), how often a launch is it and its points
HELLOWIN_FLYER_RARE=;;;;
HELLOWIN_FLYER_RARE_CHANCE=0.08
HELLOWIN_FLYER_RARE_POINTS=10
# The moderator's burst of flyers of the current set: ceil(BASE + PER_PLAYER × (n − 1)) of them, on every press
HELLOWIN_FLYER_BURST_BASE=5
HELLOWIN_FLYER_BURST_PER_PLAYER=0.2

# Zombies of the cursed world wander until shot: never fewer than HELLOWIN_ZOMBIE_MIN alive, one more every
# HELLOWIN_ZOMBIE_INTERVAL milliseconds (range or fixed) while fewer than HELLOWIN_ZOMBIE_PER_PLAYER per character on
# the floor are alive; points for one
HELLOWIN_ZOMBIE_INTERVAL=2000-5000
HELLOWIN_ZOMBIE_MIN=5
HELLOWIN_ZOMBIE_PER_PLAYER=5
HELLOWIN_ZOMBIE_POINTS=2
# While FrankenPHP is up, a wandering zombie burns after these milliseconds (0 — none burns) and heals the boss by
# this much
HELLOWIN_ZOMBIE_BURN_MS=5000
HELLOWIN_ZOMBIE_HEAL=3

# The elephant with the release banner, on a timer of its own: milliseconds from the last one (min,max or fixed) and
# milliseconds across the sky
HELLOWIN_ELEPHANT_INTERVAL=180000,360000
HELLOWIN_ELEPHANT_DURATION=26000
# Milliseconds after its fart before a shot makes it fart again, and the chance it flies low over the hills
HELLOWIN_ELEPHANT_FART_COOLDOWN_MS=1000
HELLOWIN_ELEPHANT_LOW_CHANCE=0.33

HELLOWIN_BOSS_HP_PER_PLAYER=5
# The shooters' top: rows it carries at most, and milliseconds the ticker waits at least between two publications
HELLOWIN_TOP_BOARD=200
HELLOWIN_TOP_INTERVAL=500
# The players' chat: characters of a message at most, and messages the moderator's history keeps
HELLOWIN_CHAT_MAX=120
HELLOWIN_CHAT_HISTORY=50
# The emote panel: its emoji, comma-separated, in the order of the buttons, and milliseconds between two emotes of one
# player
HELLOWIN_EMOTES=🎃,👻,💀,😂,😱,😍,👍,👏,🔥,🍺,🤘,🙏,🎉
HELLOWIN_EMOTE_COOLDOWN_MS=1000
# RoadRunner's «Мип-мип!» on anyone's click: one for the whole room per these milliseconds (0 — no cooldown)
HELLOWIN_MEEP_COOLDOWN_MS=1500
# The players' abilities: a player without an ability gets fart each time their points pass a multiple of FART_POINTS;
# the owl names a new ability at most once per OWL_GAP; flyers launches FLYERS_COUNT flyers of FLYERS_KINDS in any
# scene; each ability's cooldown per player is *_COOLDOWN
HELLOWIN_ABILITY_FART_POINTS=100
HELLOWIN_ABILITY_OWL_GAP_MS=10000
HELLOWIN_ABILITY_FLYERS_COUNT=3
HELLOWIN_ABILITY_FLYERS_KINDS=duck,chicken
HELLOWIN_ABILITY_FLYERS_COOLDOWN_MS=3000
HELLOWIN_ABILITY_FART_COOLDOWN_MS=1000
HELLOWIN_ABILITY_MEEP_COOLDOWN_MS=1000
HELLOWIN_ABILITY_LIGHTNING_COOLDOWN_MS=5000
HELLOWIN_ABILITY_PUMPKIN_COOLDOWN_MS=1000

# The dice of finale step 1: seconds the answer of an attempt is kept for a repeat, milliseconds between new throws of
# one player
HELLOWIN_DICE_IDEMPOTENCY_TTL=900
HELLOWIN_DICE_COOLDOWN_MS=1800

# The rapier step: milliseconds before the owl hints the word, and before a zombie player is cured by itself (0 — off)
HELLOWIN_WORD_HINT_MS=180000
HELLOWIN_ZOMBIE_PLAYER_MS=60000

# Characters on the lawn: percents of the screen per second along the path, and milliseconds without connections
# before a character leaves
HELLOWIN_WALK_SPEED=12
HELLOWIN_WALK_LEAVE_AFTER=5000

# RPC limits per player (per connection without one): "<per second>,<burst>" of a token bucket, 0 turns the limit
# off; click, shoot, move and say have their own buckets, every other method shares the last one
HELLOWIN_RPC_RATE_CLICK=20,40
HELLOWIN_RPC_RATE_SHOOT=20,40
HELLOWIN_RPC_RATE_MOVE=10,20
HELLOWIN_RPC_RATE_SAY=1,3
HELLOWIN_RPC_RATE_OTHER=10,30

# The autopilot of the evening, milliseconds: a pause after the owl has finished, before a move and between the
# owl's throws; the dawn lasts a random MIN…MAX before «В бар»; the owl throws the dice after DICE without a 6-6-6
# (0 — never); after STALL without the room's task the autopilot moves with force (0 — never); a room without a
# single connection for EMPTY_RESET starts the story over, as the moderator's reset does (0 — never)
HELLOWIN_AUTO_PAUSE_MS=4000
HELLOWIN_AUTO_DAWN_MIN_MS=300000
HELLOWIN_AUTO_DAWN_MAX_MS=600000
HELLOWIN_AUTO_DICE_MS=90000
HELLOWIN_AUTO_STALL_MS=0
HELLOWIN_AUTO_EMPTY_RESET_MS=30000
