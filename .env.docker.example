# Variables for docker compose. Copy to .env (or pass with --env-file) and fill in.

# Required: Grafana admin password (applied on the first start only)
GF_SECURITY_ADMIN_PASSWORD=change-me
# GF_SECURITY_ADMIN_USER=admin

# External nginx port and address; keep CENTRIFUGO_ALLOWED_ORIGINS in sync with them
# HTTP_PORT=8080
# PUBLIC_URL=http://localhost:8080
# CENTRIFUGO_ALLOWED_ORIGINS="http://localhost:8080 http://127.0.0.1:8080"

# Click counts that switch the page stage, ascending, comma-separated
# HELLOWIN_THRESHOLDS=100,500,2000

# CENTRIFUGO_WS_URL=/connection/websocket
# PROMETHEUS_RETENTION=15d
