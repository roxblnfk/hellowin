# Variables for docker compose. Copy to .env (or pass with --env-file) and fill in.

# Grafana admin password (applied on the first start only); defaults to "admin", set it for public deployments
# GF_SECURITY_ADMIN_PASSWORD=change-me
# GF_SECURITY_ADMIN_USER=admin

# Published ports: the site (RoadRunner http), the Centrifugo WebSocket and Grafana. Keep CENTRIFUGO_ALLOWED_ORIGINS in
# sync with the addresses the site is opened by
# HTTP_PORT=8080
# CENTRIFUGO_PORT=8000
# GRAFANA_PORT=3000
# CENTRIFUGO_ALLOWED_ORIGINS="http://localhost:8080 http://127.0.0.1:8080"
# The address Grafana builds its own links from
# GRAFANA_ROOT_URL=http://localhost:3000/

# HTTPS on a public domain: RoadRunner gets and renews the Let's Encrypt certificate, Centrifugo and Grafana take it
# (docs/spec/infra.md, "HTTPS на домене"). Origins and Grafana's root URL then go https://<domain>
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# DOMAIN=example.com
# ACME_EMAIL=admin@example.com

# Every limit: max(1, ceil(k × (BASE + PER_PLAYER × (n − 1)))) plus the moderator's bonus, n — figures on the floor;
# clicks per stage of a pumpkin, the bonfire and the circle, mugs of the bar, goals of the cursed world, FrankenPHP's health
# HELLOWIN_PUMPKIN_BASE=2
# HELLOWIN_PUMPKIN_PER_PLAYER=5
# HELLOWIN_BONFIRE_BASE=8
# HELLOWIN_BONFIRE_PER_PLAYER=20
# HELLOWIN_CIRCLE_BASE=15
# HELLOWIN_CIRCLE_PER_PLAYER=40
# HELLOWIN_BAR_BASE=5
# HELLOWIN_BAR_PER_PLAYER=1.5
# HELLOWIN_CURSED_DRINKS_BASE=10
# HELLOWIN_CURSED_DRINKS_PER_PLAYER=8
# HELLOWIN_CURSED_ZOMBIES_BASE=15
# HELLOWIN_CURSED_ZOMBIES_PER_PLAYER=12
# HELLOWIN_BOSS_HP_BASE=45
# HELLOWIN_BOSS_HP_PER_PLAYER=60
# Secret of the moderator console (open the page with ?moderator=<secret>); empty turns the console off
# HELLOWIN_MODERATOR_SECRET=
# Last pumpkin stage of each scene, cumulative; the scene after the last one is the final scene; a leading 0 — the bar
# HELLOWIN_SCENE_STAGE_MAX=0,4,8,11
# The bonfire: its last stage by scene, cumulative (0 — not lit in that scene)
# HELLOWIN_BONFIRE_STAGE_MAX=0,0,4,7
# The magic circle of the final scene: its last stage, where it is closed
# HELLOWIN_CIRCLE_STAGES=4
# The bar: room for mugs on the counter (the owl pours one per player, up to it), milliseconds to pour a batch, free
# places per mug of a batch (up to that many free places — one mug at once, up to twice as many — two), chance of
# a rumour
# HELLOWIN_BAR_MUGS=60
# HELLOWIN_BAR_POUR_MS=2500
# HELLOWIN_BAR_POUR_PER=10
# HELLOWIN_BAR_RUMOR_CHANCE=0.33
# Milliseconds a sip plays and a pumpkin hands its beer over: no mug is taken or drunk meanwhile
# HELLOWIN_DRINK_MS=1200
# HELLOWIN_BEER_HANDOVER_MS=900
# Litres in one mug, for the beer drunk in the statistics
# HELLOWIN_MUG_LITRES=0.5
# Flyers: milliseconds between launches, flight milliseconds and points per depth (far to near), bush and arc chances
# HELLOWIN_FLYER_INTERVAL=3000-8000
# HELLOWIN_FLYER_DURATION=16000,6500,4000
# HELLOWIN_FLYER_POINTS=3,2,1
# HELLOWIN_FLYER_BUSH_CHANCE=0.4
# HELLOWIN_FLYER_ARC_CHANCE=0.5
# Flyer kinds by scene (sets separated by ";", empty — no flyers), the rare flyer of each scene, its chance and points
# HELLOWIN_FLYER_KINDS=fly;duck,chicken;;bat;worm
# HELLOWIN_FLYER_RARE=;;;;
# HELLOWIN_FLYER_RARE_CHANCE=0.08
# HELLOWIN_FLYER_RARE_POINTS=10
# The moderator's burst: ceil(BASE + PER_PLAYER × (n − 1)) flyers of the current set, on every press
# HELLOWIN_FLYER_BURST_BASE=5
# HELLOWIN_FLYER_BURST_PER_PLAYER=0.2
# The cursed world's own set of kinds instead of its scene's, points for a firefly
# HELLOWIN_FLYER_KINDS_CURSED=worm,bat,firefly
# HELLOWIN_FLYER_FIREFLY_POINTS=1
# The dawn's own set of kinds and its pace
# HELLOWIN_FLYER_KINDS_DAWN=duck,chicken
# HELLOWIN_FLYER_INTERVAL_DAWN=1000-2500
# Flies of the bar: landings, milliseconds on each, milliseconds between points, points for one
# HELLOWIN_FLYER_FLY_STOPS=2-3
# HELLOWIN_FLYER_FLY_SIT=900-1600
# HELLOWIN_FLYER_FLY_LEG=900
# HELLOWIN_FLYER_FLY_POINTS=1
# Wandering zombies of the cursed world: milliseconds between them, how many always alive, how many per player at
# most on the beat, points for one
# HELLOWIN_ZOMBIE_INTERVAL=2000-5000
# HELLOWIN_ZOMBIE_MIN=5
# HELLOWIN_ZOMBIE_PER_PLAYER=5
# HELLOWIN_ZOMBIE_POINTS=2
# While FrankenPHP is up, a wandering zombie burns after these milliseconds (0 — none burns) and heals the boss by
# this much
# HELLOWIN_ZOMBIE_BURN_MS=5000
# HELLOWIN_ZOMBIE_HEAL=3
# The elephant with the release banner, on a timer of its own: milliseconds from the last one (min,max or fixed) and
# milliseconds across the sky
# HELLOWIN_ELEPHANT_INTERVAL=180000,360000
# HELLOWIN_ELEPHANT_DURATION=26000
# Milliseconds after its fart before a shot makes it fart again, and the chance it flies low over the hills
# HELLOWIN_ELEPHANT_FART_COOLDOWN_MS=1000
# HELLOWIN_ELEPHANT_LOW_CHANCE=0.33
# The shooters' top: rows it carries at most, milliseconds between two publications at least
# HELLOWIN_TOP_BOARD=200
# HELLOWIN_TOP_INTERVAL=500
# The players' chat: characters of a message at most, and messages the moderator's history keeps
# HELLOWIN_CHAT_MAX=120
# HELLOWIN_CHAT_HISTORY=50
# Emotes over a character: the set in the order of the picker, milliseconds between two of one player
# HELLOWIN_EMOTES=🎃,👻,💀,😂,😱,😍,👍,👏,🔥,🍺,🤘,🙏,🎉
# HELLOWIN_EMOTE_COOLDOWN_MS=1000
# RoadRunner's «Мип-мип!» on anyone's click: one for the whole room per these milliseconds (0 — no cooldown)
# HELLOWIN_MEEP_COOLDOWN_MS=1500
# The players' abilities: the shot flyer that brings a player's count to FART_FLYERS grants fart to one without an
# ability; the owl names a new ability at most once per OWL_GAP; flyers launches FLYERS_COUNT flyers; each ability's
# cooldown per player is *_COOLDOWN
# HELLOWIN_ABILITY_FART_FLYERS=100
# HELLOWIN_ABILITY_OWL_GAP_MS=10000
# HELLOWIN_ABILITY_FLYERS_COUNT=3
# HELLOWIN_ABILITY_FLYERS_COOLDOWN_MS=3000
# HELLOWIN_ABILITY_FART_COOLDOWN_MS=1000
# HELLOWIN_ABILITY_MEEP_COOLDOWN_MS=1000
# The dice of finale step 1: seconds an attempt's answer is kept for a repeat, pause between throws
# HELLOWIN_DICE_IDEMPOTENCY_TTL=900
# HELLOWIN_DICE_COOLDOWN_MS=1800
# The rapier step: milliseconds before the owl hints the word, and before a zombie player is cured by itself (0 — off)
# HELLOWIN_WORD_HINT_MS=180000
# HELLOWIN_ZOMBIE_PLAYER_MS=60000
# Characters: percents of the screen per second, milliseconds without connections before a character leaves
# HELLOWIN_WALK_SPEED=12
# HELLOWIN_WALK_LEAVE_AFTER=5000
# RPC limits per player (per connection without one): "<per second>,<burst>" of a token bucket, 0 turns the limit
# off; click, shoot, move and say have their own buckets, every other method shares the last one
# HELLOWIN_RPC_RATE_CLICK=20,40
# HELLOWIN_RPC_RATE_SHOOT=20,40
# HELLOWIN_RPC_RATE_MOVE=10,20
# HELLOWIN_RPC_RATE_SAY=1,3
# HELLOWIN_RPC_RATE_OTHER=10,30

# The autopilot of the evening, milliseconds: a pause after the owl has finished, before a move and between the
# owl's throws; the dawn lasts a random MIN…MAX before «В бар»; the owl throws the dice after DICE without a 6-6-6
# (0 — never); after STALL without the room's task the autopilot moves with force (0 — never); a room without a
# single connection for EMPTY_RESET starts the story over, as the moderator's reset does (0 — never)
# HELLOWIN_AUTO_PAUSE_MS=4000
# HELLOWIN_AUTO_DAWN_MIN_MS=300000
# HELLOWIN_AUTO_DAWN_MAX_MS=600000
# HELLOWIN_AUTO_DICE_MS=90000
# HELLOWIN_AUTO_STALL_MS=0
# HELLOWIN_AUTO_EMPTY_RESET_MS=30000

# Links of the page to Centrifugo and Grafana: ":<port>/path" takes the host of the page, a full URL is used as is
# CENTRIFUGO_WS_URL=:8000/connection/websocket
# GRAFANA_URL=:3000/
# PROMETHEUS_RETENTION=15d
