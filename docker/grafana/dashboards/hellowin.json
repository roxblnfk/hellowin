{
  "uid": "hellowin",
  "title": "Hellowin",
  "description": "Clicks, ritual scene, idempotent transitions, players, flyers and WebSocket traffic of the Hellowin demo (RoadRunner + Centrifugo).",
  "tags": ["hellowin", "roadrunner", "centrifugo"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 3,
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Game",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total clicks",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(hellowin_clicks_total) or vector(0)", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current scene",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 5, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(hellowin_scene_stage) or vector(0)", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Scene of the ritual (0 … final). Moves when every pumpkin reached the last stage of the scene."
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Round",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 9, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(hellowin_round) or vector(0)", "instant": true, "range": false }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Pass of the ritual; grows with every reset. It is part of every idempotency key."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Clicks per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 13, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(hellowin_clicks_total[1m])) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Online (WebSocket connections)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(centrifugo_node_num_clients) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Clicks per second by element",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 6 },
      "targets": [
        { "refId": "A", "expr": "sum by (element) (rate(hellowin_clicks_total[1m]))", "legendFormat": "{{element}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Clicks by element (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (element) (hellowin_clicks_total))",
          "legendFormat": "{{element}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "continuous-YlRd" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scene and round",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 15 },
      "targets": [
        { "refId": "A", "expr": "max(hellowin_scene_stage)", "legendFormat": "scene" },
        { "refId": "C", "expr": "max(hellowin_round)", "legendFormat": "round" },
        { "refId": "B", "expr": "sum(hellowin_clicks_total)", "legendFormat": "total clicks" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total clicks" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineInterpolation", "value": "linear" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "scene" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "round" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Transitions: queue and idempotency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Jobs pushed vs transitions applied (per minute)",
      "description": "Every click over the threshold pushes a transition job until the transition is done; the idempotency key lets only one of them run.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (increase(hellowin_transition_jobs_pushed_total[1m]))", "legendFormat": "pushed {{kind}}" },
        { "refId": "B", "expr": "sum by (kind) (increase(hellowin_transitions_total[1m]))", "legendFormat": "applied {{kind}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "Jobs pushed vs transitions applied (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (hellowin_transition_jobs_pushed_total)",
          "legendFormat": "pushed {{kind}}",
          "instant": true,
          "range": false
        },
        { "refId": "B", "expr": "sum by (kind) (hellowin_transitions_total)", "legendFormat": "applied {{kind}}", "instant": true, "range": false }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Duplicates dropped",
      "description": "Transition jobs pushed minus transitions applied: duplicates the idempotency key stopped (a few may still be waiting in the queue).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (hellowin_transition_jobs_pushed_total) - sum by (kind) (hellowin_transitions_total)",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 24,
      "type": "bargauge",
      "title": "Pumpkin stages",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 30 },
      "targets": [
        { "refId": "A", "expr": "max by (element) (hellowin_pumpkin_stage)", "legendFormat": "{{element}}", "instant": true, "range": false }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "continuous-YlRd" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "vertical",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Players",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "panels": []
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Players",
      "description": "Browsers known by their secret, named or not. The ticker counts them every 5 seconds.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 40 },
      "targets": [{ "refId": "A", "expr": "max(hellowin_players)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Registered (named)",
      "description": "Players who sent RPC register with a name.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 40 },
      "targets": [{ "refId": "A", "expr": "max(hellowin_players_registered)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Players over time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 40 },
      "targets": [
        { "refId": "A", "expr": "max(hellowin_players)", "legendFormat": "players" },
        { "refId": "B", "expr": "max(hellowin_players_registered)", "legendFormat": "registered" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Online",
      "description": "Кто подключён к каналу сейчас, по presence Centrifugo: уникальные игроки и все подключения (вкладки, анонимы включительно). Тикер выставляет раз в секунду.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 46 },
      "targets": [
        { "refId": "A", "expr": "max(hellowin_online_players)", "legendFormat": "players" },
        { "refId": "B", "expr": "max(hellowin_online_connections)", "legendFormat": "connections" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 43,
      "type": "stat",
      "title": "Beer drunk, L",
      "description": "Mugs drunk by all players ever, in the bar and in the cursed world, times HELLOWIN_MUG_LITRES. Summed from the player records in Valkey, so a restart keeps it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 40 },
      "targets": [{ "refId": "A", "expr": "max(hellowin_beer_litres)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "litre", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Mugs per minute by place",
      "description": "RPC drink: bar is scene 0, cursed is the cursed world of the finale.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 40 },
      "targets": [{ "refId": "A", "expr": "sum by (place) (increase(hellowin_beer_mugs_total[1m]))", "legendFormat": "{{place}}" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 34,
      "type": "row",
      "title": "Flyers: launched, shot, escaped",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "panels": []
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Flyers per minute",
      "description": "The ticker launches flyers and counts the ones that left the screen; RPC shoot counts hits. Every flyer ends exactly once: launched = shot + escaped + still in the sky.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(hellowin_flyers_launched_total[1m]))", "legendFormat": "launched" },
        { "refId": "B", "expr": "sum(increase(hellowin_flyers_shot_total[1m]))", "legendFormat": "shot" },
        { "refId": "C", "expr": "sum(increase(hellowin_flyers_escaped_total[1m]))", "legendFormat": "escaped" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 36,
      "type": "bargauge",
      "title": "Flyers by depth (total)",
      "description": "Depth 0 is the farthest: slowest and worth the most points.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 53 },
      "targets": [
        { "refId": "A", "expr": "sum by (depth) (hellowin_flyers_launched_total)", "legendFormat": "launched, depth {{depth}}", "instant": true, "range": false },
        { "refId": "B", "expr": "sum by (depth) (hellowin_flyers_shot_total)", "legendFormat": "shot, depth {{depth}}", "instant": true, "range": false },
        { "refId": "C", "expr": "sum by (depth) (hellowin_flyers_escaped_total)", "legendFormat": "escaped, depth {{depth}}", "instant": true, "range": false }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 37,
      "type": "stat",
      "title": "Hit rate",
      "description": "Shot flyers out of the flyers that are over: shot / (shot + escaped).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 53 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hellowin_flyers_shot_total) / (sum(hellowin_flyers_shot_total) + sum(hellowin_flyers_escaped_total))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "green", "value": 0.5 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Centrifugo (WebSockets)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connections and subscriptions",
